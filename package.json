{
  "name": "kidtropy",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source, touch-first learning games for preschoolers: trucks, diggers, dinosaurs, animals, farms and racing.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14",
    "wrangler": "^4.50.0"
  }
}
