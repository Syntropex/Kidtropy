{
  // Kidtropy is a fully static app served by Cloudflare Workers Static Assets.
  // No server code runs: everything happens on the child's device.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidtropy",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "kidtropy.syntropex.tech", "custom_domain": true }]
}
